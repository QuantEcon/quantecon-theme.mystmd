{
  "name": "@quantecon/lecture-theme",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./app/links.ts"
  ],
  "scripts": {
    "compile": "react-router typegen && tsc --noEmit --skipLibCheck",
    "build:css": "tailwindcss -m -i ./styles/app.css -o app/styles/app.css",
    "build:thebe": "copy-thebe-assets ./public",
    "build:pre": "npm run build:thebe && npm run build:css",
    "build:server": "react-router build",
    "build:renderer": "cross-env VITE_BUILD_HTML=1 react-router build",
    "prod:build": "npm run build:pre && npm run build:server && npm run build:renderer",
    "clean": "rm -rf build .react-router app/styles/app.css",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "dev:css": "tailwindcss -w -i ./styles/app.css -o app/styles/app.css",
    "dev": "npm run build:thebe && concurrently \"npm run dev:css\" \"cross-env NODE_ENV=development tsx server.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:plugin": "node --test \"tests/plugin/**/*.test.mjs\"",
    "test:fouc": "playwright test --project=webkit-fouc"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@myst-theme/common": "^2.1.1",
    "@myst-theme/frontmatter": "^2.1.1",
    "@myst-theme/icons": "^2.1.1",
    "@myst-theme/jupyter": "^2.1.1",
    "@myst-theme/prerender": "^0.3.0",
    "@myst-theme/providers": "^2.1.1",
    "@myst-theme/search": "^2.1.1",
    "@myst-theme/search-minisearch": "^2.1.1",
    "@myst-theme/site": "^2.1.1",
    "@myst-theme/styles": "^2.1.1",
    "@quantecon/theme-common": "*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "classnames": "^2.5.1",
    "compression": "^1.8.0",
    "express": "^4.22.3",
    "get-port": "^5.1.1",
    "isbot": "^5.1.40",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "morgan": "^1.10.0",
    "myst-common": "^1.11.0",
    "myst-config": "^1.11.0",
    "myst-migrate": "^1.13.0",
    "myst-spec-ext": "^1.11.0",
    "myst-to-react": "^2.1.1",
    "node-fetch": "^2.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.5.1",
    "thebe-core": "^0.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/lodash.throttle": "^4.1.9",
    "@types/morgan": "^1.9.10",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "patch-package": "^8.0.0",
    "prettier": "latest",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
