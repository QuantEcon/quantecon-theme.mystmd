{
  "name": "quantecon-theme-workspace",
  "private": true,
  "description": "QuantEcon MyST themes: an npm workspace holding the shared package and the themes built on it.",
  "workspaces": [
    "packages/*",
    "themes/*"
  ],
  "scripts": {
    "postinstall": "patch-package --patch-dir patches",
    "compile": "npm run compile --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "prod:build": "npm run prod:build -w @quantecon/lecture-theme",
    "dev": "npm run dev -w @quantecon/lecture-theme",
    "test:visual": "npm run test:visual -w @quantecon/lecture-theme",
    "test:visual:update": "npm run test:visual:update -w @quantecon/lecture-theme",
    "test:plugin": "npm run test:plugin -w @quantecon/lecture-theme",
    "test:fouc": "npm run test:fouc -w @quantecon/lecture-theme"
  },
  "devDependencies": {
    "patch-package": "^8.0.0"
  },
  "overrides": {
    "prismjs": "^1.30.0",
    "katex": "^0.16.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^11.1.1",
    "ajv": "^8.18.0",
    "cookie": "^0.7.0",
    "shell-quote": "^1.12.0",
    "ws@^8.0.0": "^8.20.1",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9",
    "js-yaml@^3.0.0": "^3.15.0",
    "js-yaml@^4.0.0": "^4.3.0",
    "sanitize-html": "2.17.5",
    "@babel/core": "^7.29.6"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
