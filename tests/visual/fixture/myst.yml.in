# Template for the visual-regression fixture project.
# `serve.sh` copies this to `myst.yml`, substituting __THEME__ with the theme
# under test (a local build dir for 2.0.0, or a GitHub archive zip for v1.1.1).
version: 1
project:
  title: QuantEcon Theme — Visual Fixture
  github: https://github.com/QuantEcon/quantecon-theme.mystmd
  plugins:
    - fancy-lists.mjs
  # In-browser live compute (Pyodide). Surfaces the @myst-theme/jupyter
  # NotebookToolbar (Power/Run/Restart/Clear) on notebook pages.
  thebe:
    lite: true
  toc:
    - file: intro.md
    - file: features.md
    - file: lists.md
    - file: notebook.ipynb
site:
  title: QE Theme Visual Fixture
  template: __THEME__
  options:
    logo_text: QuantEcon Visual Fixture
    # Multilingual editions (#90, #143). Two editions make the toolbar's
    # language switcher and the hreflang alternates render on every page; the
    # lists are YAML blocks because template options are scalar-only (see
    # app/i18n.ts). The Persian edition lives in ../fixture-rtl.
    current_language: en
    languages: |
      - code: en
        name: English
        url: https://example.org/en
      - code: fa
        name: فارسی
        url: https://example.org/fa/
    translators: |
      - name: Jane Translator
        url: https://example.org/jane
  parts:
    footer: footer.md
