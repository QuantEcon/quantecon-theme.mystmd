# Template for the visual-regression fixture project.
# `serve.sh` copies this to `myst.yml`, substituting __THEME__ with the theme
# under test (a local theme build dir or a zip URL).
version: 1
project:
  title: QuantEcon Theme — Visual Fixture
  github: https://github.com/QuantEcon/quantecon-theme.mystmd
  plugins:
    - fancy-lists.mjs
  # In-browser live compute (Pyodide). Surfaces the @myst-theme/jupyter
  # NotebookToolbar (Power/Run/Restart/Clear) on notebook pages.
  thebe:
    lite: true
  toc:
    - file: intro.md
    - file: features.md
    - file: lists.md
    - file: notebook.ipynb
site:
  title: QE Theme Visual Fixture
  template: __THEME__
  options:
    # Site-wide options declared in template.yml. `twitter` and `favicon`
    # are asserted end to end in theme.spec.ts ("site-options"): the CLI
    # drops undeclared keys, so this is the fixture's proof that a declared
    # one reaches the theme.
    twitter: quantecon
    favicon: cc-by-sa-4.0-80x15.png
    # Launch is opt-in on both axes, so the `launch-colab` test needs both a
    # notebook repository and a service. `fixture-no-thebe` sets neither, which
    # is what `launch-absent-without-config` asserts.
    launch_notebook_repo: QuantEcon/quantecon-theme.notebooks
    launch_colab: true
    # Multilingual editions. Two editions make the toolbar's language
    # switcher and the hreflang alternates render on every page; the lists
    # are YAML blocks because template options are scalar-only (see
    # app/i18n.ts). The Persian edition lives in ../fixture-rtl.
    current_language: en
    languages: |
      - code: en
        name: English
        url: https://example.org/en
      - code: fa
        name: فارسی
        url: https://example.org/fa/
    translators: |
      - name: Jane Translator
        url: https://example.org/jane
  parts:
    footer: footer.md
